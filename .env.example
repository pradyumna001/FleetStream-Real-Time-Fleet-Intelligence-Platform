# Copy to .env before running the stack:  cp .env.example .env
#
# Two Kafka listeners exist. Use the one that matches where your code runs:
#   kafka:29092      - from inside the Docker network (Spark, Airflow, simulator container)
#   localhost:9092   - from the Windows host (host-run producer, kafka CLI)

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TELEMETRY_TOPIC=fleet.telemetry
INCIDENTS_TOPIC=fleet.incidents
DLQ_TOPIC=fleet.telemetry.dlq
TELEMETRY_PARTITIONS=12

# MinIO stands in for S3. These credentials are local-only throwaways; the real
# deployment sources them from IAM roles, never from environment variables.
S3_ENDPOINT=http://minio:9000
CHECKPOINT_ROOT=s3a://fleetstream/checkpoints
S3_ENDPOINT_HOST=http://localhost:9000
S3_ACCESS_KEY=fleetstream
S3_SECRET_KEY=fleetstream-local-secret
S3_REGION=us-east-1
WAREHOUSE_BUCKET=fleetstream

# Iceberg REST catalog
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_REST_URI_HOST=http://localhost:8181
CATALOG_NAME=fleetstream

# Trino
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=fleetstream

# Simulator behaviour. The injection rates are what make the platform's
# correctness claims testable rather than decorative - see docs/architecture.md.
SIM_VEHICLE_COUNT=200
SIM_EVENTS_PER_VEHICLE_PER_MIN=10
SIM_SPEEDUP=60
SIM_SEED=20260908
SIM_DUPLICATE_RATE=0.01
SIM_LATE_RATE=0.02
SIM_INVALID_RATE=0.005
SIM_HOT_VEHICLE=V9999
SIM_HOT_VEHICLE_MULTIPLIER=25

# Grafana
GRAFANA_ADMIN_PASSWORD=fleetstream

# Spark standalone worker sizing.
#
# The three streaming queries request 2 + 2 + 1 cores via spark.cores.max, so 5 cores
# is exactly enough and anything more sits idle. 4G holds their three 1G executors
# with headroom. Sized to leave room for Trino and Airflow on a 12GB Docker VM -
# raise both if you have more.
SPARK_WORKER_CORES=5
SPARK_WORKER_MEMORY=4G

# Airflow UI login (http://localhost:8082).
#
# Airflow 3 uses SimpleAuthManager, which otherwise generates a random password on
# first start. This makes it deterministic. Plaintext, dev-only - production would
# use the FAB or Keycloak auth manager.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
